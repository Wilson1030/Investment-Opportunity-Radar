# ============================================================
# Investment Opportunity Radar · .gitignore
# ============================================================

# --- 密钥与本地配置（绝不入库）---
.env
.env.local
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.venv/
venv/

# --- 数据库 ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- 采集缓存与原始文件（体积大、可重建）---
data/cache/
data/raw/
!data/cache/.gitkeep
!data/raw/.gitkeep

# --- LLM / 节点级缓存 ---
.cache/
backend/.cache/

# --- Node / 前端 ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- 编辑器 / 系统 ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- 日志 ---
*.log
logs/

# --- 前端构建产物 ---
frontend/dist/
frontend/node_modules/
frontend/.tsbuildinfo
