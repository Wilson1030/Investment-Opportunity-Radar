# ============================================================
# Investment Opportunity Radar · 环境变量模板
# ============================================================
# 用法：
#     cp .env.example .env      # 然后按需修改
#     .env 已被 .gitignore 忽略，切勿提交
#
# 设计原则：
#   1) **默认零配置**：开发/试用默认走本机 Ollama，不需要任何 API key、不花钱，
#      公告内容也不出本机。
#   2) **换模型只改一个名字**：每个 provider 的端点已内置（见
#      backend/app/ai/provider.py 的 PROVIDER_PRESETS），
#      你只需要写 provider 名 + 填对应的 key，不必记 base_url。
#   3) 全部 provider 都可切换、可混用（比如「抽取用本地、分析用云端」）。


# ============================================================
# 1) 运行模式
# ============================================================
# dev     = 抽取层与分析层都走本机 Ollama（默认，零成本）
# cloud   = 都走云端（用下面的 *_PROVIDER 配置）
# hybrid  = 抽取层本地、分析层云端（推荐的成本/质量折中）
LLM_MODE=dev

# dry_run = 采集真实执行但**不写判断类数据**（Event/Evidence/Opportunity）
# 建议初次使用保持 true，观察几轮确认数据质量后再改 false
INGEST_DRY_RUN=true


# ============================================================
# 2) 抽取层（量大、任务简单：公告 → 结构化事件）
# ============================================================
# provider 可选（见 provider.py 的 PROVIDER_PRESETS）：
#   ollama(默认) / deepseek / zhipu(glm) / kimi(moonshot) / dashscope(qwen)
#   / siliconflow / minimax / openai / claude / openrouter / groq / custom
#
# ★ 换厂商只改这两行（base_url 自动带上）：
EXTRACT_PROVIDER=ollama
EXTRACT_MODEL=qwen3:4b
EXTRACT_BASE_URL=
EXTRACT_API_KEY=

# 例：用 DeepSeek 抽取
#   EXTRACT_PROVIDER=deepseek
#   EXTRACT_MODEL=deepseek-chat
#   （端点自动为 https://api.deepseek.com，key 读 DEEPSEEK_API_KEY）

# 例：用智谱 GLM 抽取
#   EXTRACT_PROVIDER=zhipu
#   EXTRACT_MODEL=glm-4-flash

# 例：自建/中转（vLLM / LM Studio / one-api 等）——**必须**给 base_url
#   EXTRACT_PROVIDER=custom
#   EXTRACT_MODEL=your-model
#   EXTRACT_BASE_URL=http://localhost:8000/v1
#   EXTRACT_API_KEY=sk-xxx


# ============================================================
# 3) 分析层（量小、需要推理：反证检索 / 研究叙事 / 语义分）
# ============================================================
# 独立配置，便于「抽取用便宜模型、分析用强模型」
ANALYZE_PROVIDER=ollama
ANALYZE_MODEL=qwen3:4b
ANALYZE_BASE_URL=
ANALYZE_API_KEY=

# 例：分析层用强模型（LLM_MODE=hybrid 时生效）
#   ANALYZE_PROVIDER=deepseek
#   ANALYZE_MODEL=deepseek-reasoner


# ============================================================
# 4) 各 provider 的 API Key（**用哪家填哪家，其余留空**）
# ============================================================
# 端点不用写 —— 已内置在 PROVIDER_PRESETS 里。若走代理/中转，
# 再用对应的 *_BASE_URL 覆盖（见下面的通用覆盖项）。

# --- 本机 Ollama（默认，无需 key）---
# 装好 Ollama 后：ollama pull qwen3:4b

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- 智谱 GLM ---
ZHIPU_API_KEY=

# --- 月之暗面 Kimi / Moonshot ---
KIMI_API_KEY=

# --- 阿里通义千问（DashScope 兼容模式）---
DASHSCOPE_API_KEY=

# --- 硅基流动 ---
SILICONFLOW_API_KEY=

# --- MiniMax ---
MINIMAX_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Anthropic Claude（原生 messages 接口）---
ANTHROPIC_API_KEY=

# --- OpenRouter（一个 key 访问多家）---
OPENROUTER_API_KEY=

# --- Groq（速度极快）---
GROQ_API_KEY=

# --- 自建 / 中转（未列出的厂商也走这里）---
LLM_API_KEY=


# ============================================================
# 5) Ollama 相关（仅 LLM_MODE=dev 时有意义）
# ============================================================
# ★ qwen3 是**思考型模型**，其推理 token 也会占用输出上限 ——
#   不关思考时，2500 的额度会被推理吃光、正文一个 token 都轮不到
#   （表现为「抽取未通过 Schema 校验」）。抽取是结构化转换，不需要推理。
LLM_DISABLE_THINKING=true

# 单次生成的最大输出 token（防模型陷入重复生成循环）
LLM_MAX_OUTPUT_TOKENS=2500

# 单条公告送入 LLM 的最大字符数 / 段落数（截断预算）
LLM_MAX_INPUT_CHARS=6000
LLM_MAX_PARAGRAPHS=14


# ============================================================
# 6) 数据库
# ============================================================
DATABASE_URL=sqlite:///./data/radar.db


# ============================================================
# 7) 采集范围（改这一行即可放宽到全市场）
# ============================================================
# st_and_risk_warning = ST/*ST + 近期重组类/控制权类公告公司
# all_a_shares        = 沪深北全市场（约 5400 只，建议配云端模型）
INGEST_SCOPE=st_and_risk_warning
INGEST_LOOKBACK_DAYS=90

# cninfo 全文检索关键词（留空 = 扫全市场；填则只扫命中该词的公告）
# 例：INGEST_SEARCHKEY=重整
INGEST_SEARCHKEY=


# ============================================================
# 8) 调度器（交易日感知三段式）
# ============================================================
SCHEDULER_ENABLED=false
TIMEZONE=Asia/Shanghai
SCHEDULE_PREMARKET=08:30
SCHEDULE_INTRADAY_MINUTES=30
SCHEDULE_POSTMARKET=15:30


# ============================================================
# 9) 行为开关
# ============================================================
# 是否对入池机会跑 AI 分析（反证检索 / 研究叙事 / 语义分）
# 关掉后只出规则分 —— 用于调试或不想花 token 的场景
WITH_AI_ANALYSIS=true

# 公告全文落库（false 时证据链会退化为「公告级」）
STORE_ANNOUNCEMENT_FULLTEXT=true

# 扫描件 PDF 是否尝试 OCR（默认关闭，仅标记 needs_ocr）
ENABLE_OCR=false
