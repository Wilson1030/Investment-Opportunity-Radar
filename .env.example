# ============================================================
# Investment Opportunity Radar · 环境变量模板
# ============================================================
# 用法：复制为 .env 并填写。.env 已被 .gitignore 忽略，切勿提交。
#
#    cp .env.example .env
#
# 设计原则：
#   1) 开发期默认使用本机 Ollama（零 API 成本），云端 provider 全部预留但不依赖。
#   2) 所有 provider 的 key/base_url/模型名都可独立覆盖，切换只改本文件。
#   3) 本项目与任何其他项目完全独立，不共用密钥文件、不互相 import。


# ============================================================
# 1) 运行模式
# ============================================================
# dev = 本机 Ollama；cloud = 云端 API；hybrid = 抽取用本地、分析用云端
LLM_MODE=dev

# dry_run = 采集只打印不写库（调度器预热期强烈建议开启）
INGEST_DRY_RUN=true

# ============================================================
# 2) 抽取层模型（量大、任务简单：公告 → 结构化事件）
#    每天 30~80 条公告 × 短输出，要求 JSON 稳定、单价低
# ============================================================
EXTRACT_PROVIDER=ollama
EXTRACT_MODEL=qwen3:4b
EXTRACT_BASE_URL=http://127.0.0.1:11434
EXTRACT_API_KEY=

# 云端备选（当本地 JSON 合规率不达标时切换）
# EXTRACT_PROVIDER=deepseek
# EXTRACT_MODEL=deepseek-chat
# EXTRACT_BASE_URL=https://api.deepseek.com
# EXTRACT_API_KEY=sk-...

# ============================================================
# 3) 分析层模型（量小、需要推理：证据链 / 反证 / 研究卡）
# ============================================================
ANALYZE_PROVIDER=ollama
ANALYZE_MODEL=qwen3:4b
ANALYZE_BASE_URL=http://127.0.0.1:11434
ANALYZE_API_KEY=

# 云端备选
# ANALYZE_PROVIDER=deepseek
# ANALYZE_MODEL=deepseek-reasoner
# ANALYZE_BASE_URL=https://api.deepseek.com
# ANALYZE_API_KEY=sk-...

# 备用云端 provider（留空即不启用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# 4) 数据库
# ============================================================
DATABASE_URL=sqlite:///./data/radar.db

# ============================================================
# 5) 采集范围（改这一行即可放宽到全市场）
# ============================================================
# st_and_risk_warning = ST/*ST + 近 90 天重组类/控制权类公告公司（约 300 只）
# all_a_shares        = 沪深北全市场（约 5400 只，需云端模型支撑）
INGEST_SCOPE=st_and_risk_warning
INGEST_LOOKBACK_DAYS=90

# ============================================================
# 6) 调度器
# ============================================================
SCHEDULER_ENABLED=false
TIMEZONE=Asia/Shanghai
# 三段式：盘前全量 / 盘中增量 / 盘后重算
SCHEDULE_PREMARKET=08:30
SCHEDULE_INTRADAY_MINUTES=30
SCHEDULE_POSTMARKET=15:30

# ============================================================
# 7) 行为开关
# ============================================================
# 公告全文落库（false 时只存元数据 + 链接，证据链会退化为「公告级」）
STORE_ANNOUNCEMENT_FULLTEXT=true
# 扫描件 PDF 是否尝试 OCR（本轮默认关闭，仅标记 needs_ocr）
ENABLE_OCR=false
